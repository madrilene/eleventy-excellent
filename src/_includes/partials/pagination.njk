<section class="region">
  <nav role="navigation" aria-labelledby="pagination_label">
    <span id="pagination_label" hidden>{{ meta[metaKey].paginationLabel }}</span>
    <span id="prefix" hidden>{{ meta[metaKey].paginationPage }}</span>
    <ol class="pagination | cluster" role="list">
      <li>
        {% if pagination.href.previous %}
          <a class="button" data-button-variant="ghost" href="{{ pagination.href.previous }}">
            <span>{{ meta[metaKey].paginationPrevious }}</span>
          </a>
        {% else %}
          <span class="button" data-button-variant="ghost" aria-disabled="true">
            <span>{{ meta[metaKey].paginationPrevious }}</span>
          </span>
        {% endif %}
      </li>
      {% if meta[metaKey].paginationNumbers %}
        {%- for pageEntry in pagination.pages -%}
          <li>
            <a
              class="button"
              data-button-variant="ghost"
              href="{{ pagination.hrefs[ loop.index0 ] }}"
              id="link_{{ loop.index }}"
              aria-labelledby="prefix link_{{ loop.index }}"
              {% if page.url == pagination.hrefs[ loop.index0 ] %}aria-current="page"{% endif %}
            >
              <span>{{ loop.index }}</span>
            </a>
          </li>
        {%- endfor -%}
      {% endif %}
      <li>
        {% if pagination.href.next %}
          <a class="button" data-button-variant="ghost" href="{{ pagination.href.next }}">
            <span>{{ meta[metaKey].paginationNext }}</span>
          </a>
        {% else %}
          <span class="button" data-button-variant="ghost" aria-disabled="true">
            <span>{{ meta[metaKey].paginationNext }}</span>
          </span>
        {% endif %}
      </li>
    </ol>
  </nav>
</section>

{% css "local" %}
  {% include "css/pagination.css" %}
{% endcss %}
