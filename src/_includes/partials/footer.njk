<footer class="site-footer mt-l-xl p-s-m">
  <div class="wrapper">
    <div class="cluster gutter-s">
      <div class="brand | cluster gutter-2xs">
        &copy; {% year %}
        <a href="/" class="button" data-button-variant="text" {{ indicateActiveHome }}>
          <span class="font-display">{{ meta.siteName }}</span>
        </a>
        <small>{{ pkg.version }}</small>
      </div>
      <nav class="cluster gutter-xs" aria-label="{{ meta.navigation.ariaBottom }}">
        {% for item in navigation.bottom %}
          <a
            class="button"
            data-button-variant="text-underline"
            href="{{ item.url }}"
            {{
              helpers.getLinkActiveState(item.url,
              page.url)
              |
              safe
            }}
            ><span>{{ item.text }}</span></a
          >
        {% endfor %}
      </nav>

      <nav class="cluster" aria-label="{{ meta.navigation.ariaPlatforms }}">
        <!-- gets the first item from the feed loop set in meta -->
        <a
          href="{{ meta.blog.feedLinks[0].url }}"
          rel="alternate"
          type="{{ meta.blog.feedLinks[0].type }}"
          class="button"
          data-button-icon
        >
          <span class="visually-hidden">{{ meta.blog.feedLinks[0].title }}</span>
          {% svg "misc/rss" %}
        </a>

        {% for key, value in personal.platforms %}
          {% if value != "" %}
            <!-- regular platforms -->
            <a class="no-indicator button" data-button-icon href="{{ value }}" rel="me">
              <span class="visually-hidden">{{ key | capitalize }}</span>
              {% svg 'platform/' + key %}
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>

    {% include 'partials/theme-switch.njk' %}

    <aside class="creator | cluster gutter-2xs text-step-min-1 mt-xl">
      Made with <span class="visually-hidden">love</span> {% svg "misc/heart" %} and
      <a class="no-indicator" href="https://www.11ty.dev/">
        <span class="visually-hidden">Eleventy</span>
        {% svg "misc/11ty" %}
      </a>
      by
      <a href="{{ meta.creator.website }}">{{ meta.creator.name }}</a>
    </aside>
  </div>
</footer>
